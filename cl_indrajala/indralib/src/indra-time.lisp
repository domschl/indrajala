;;;; indra-time.lisp — Common Lisp port of Python indra_time.py

(in-package #:indralib)

;;; Notes:
;;; - We use UTC-only logic and Julian Date algorithms matching Python reference.
;;; - Datetime interop is implemented with CL universal time and simple conversions.

(defun datetime-to-julian (dt)
  "Convert a local-time-like plist to Julian date.
DT may be a plist with keys :year :month :day :hour :minute :second :microsecond.
For convenience, if DT is NIL, we use current time."
  (multiple-value-bind (year month day hour minute second microsecond)
      (cond
        ((null dt)
         (multiple-value-bind (sec min hr d mo yr) (decode-universal-time (get-universal-time) 0)
           (values yr mo d hr min sec 0)))
        ((hash-table-p dt)
         (values (gethash :year dt) (gethash :month dt) (gethash :day dt)
                 (gethash :hour dt) (gethash :minute dt) (gethash :second dt)
                 (gethash :microsecond dt)))
        ((listp dt)
         (values (getf dt :year) (getf dt :month) (getf dt :day)
                 (getf dt :hour) (getf dt :minute) (getf dt :second)
                 (or (getf dt :microsecond) 0)))
        (t (error "Unsupported datetime representation: ~a" dt)))
    (discrete-time-to-julian year month day hour minute second (or microsecond 0))))

(defun discrete-time-to-julian-gregorian-extended (year month day hour minute second microsecond)
  "Extended Gregorian to JD (valid even before 1582)."
  (when (<= month 2)
    (decf year)
    (incf month 12))
  (let* ((a (floor (/ year 100)))
         (b (- 2 a (floor (/ a 4))))
         (jd (+ (floor (* 365.25 (+ year 4716)))
                (floor (* 30.6001 (+ month 1)))
                day b -1524.5
                (/ hour 24.0)
                (/ minute 1440.0)
                (/ second 86400.0)
                (/ microsecond 86400000000.0))))
    jd))

(defun julian-to-discrete-time (jd)
  "JD -> (values year month day hour minute second microsecond)."
  (let* ((jd+ (+ jd 0.5))
         (z (floor jd+))
         (f (- jd+ z))
         (a (if (< z 2299161)
                 z
                 (let* ((alpha (floor (/ (- z 1867216.25) 36524.25))))
                   (+ z 1 alpha (- (floor (/ alpha 4)))))))
         (b (+ a 1524))
         (c (floor (/ (- b 122.1) 365.25)))
         (d (floor (* 365.25 c)))
         (e (floor (/ (- b d) 30.6001)))
         (day (- b d (floor (* 30.6001 e)) f))
         (month (if (< e 14) (- e 1) (- e 13)))
         (year (if (> month 2) (- c 4716) (- c 4715)))
         (hour (* 24 (- jd+ (floor jd+))))
         (minute (* 60 (- hour (floor hour))))
         (second (* 60 (- minute (floor minute))))
         (microsecond (* 1000000 (- second (floor second)))))
    (values year month (truncate day) (truncate hour) (truncate minute)
            (truncate second) (truncate microsecond))))

(defun discrete-time-to-julian (year month day hour minute second microsecond)
  "Discrete date/time -> JD with Julian->Gregorian switch in 1582-10-15."
  (when (and (= year 1582) (= month 10) (> day 4) (< day 15))
    (format *error-output* "The dates 5 - 14 Oct 1582 do not exist in the Gregorian calendar!~%")
    (return-from discrete-time-to-julian nil))
  (let* ((jy (if (> month 2) year (1- year)))
         (jm (if (> month 2) (1+ month) (+ month 13)))
         (intgr (floor (+ (floor (* 365.25 jy)) (floor (* 30.6001 jm)) day 1720995)))
         (gregcal (+ 15 (* 31 (+ 10 (* 12 1582))))))
    (when (>= (+ day (* 31 (+ month (* 12 year)))) gregcal)
      (let ((ja (floor (* 0.01 jy))))
        (incf intgr (+ 2 (- ja) (floor (* 0.25 ja))))))
    (let* ((dayfrac (- (/ hour 24.0) 0.5)))
      (when (< dayfrac 0.0)
        (incf dayfrac 1.0)
        (decf intgr))
      (let* ((frac (+ dayfrac (/ (+ minute (/ second 60.0)) 60.0 24.0)))
             (jd0 (* (+ intgr frac) 100000))
             (jd (floor jd0)))
        (when (> (- jd0 jd) 0.5) (incf jd))
        (setf jd (/ jd 100000.0))
        (+ jd (/ microsecond 86400000000.0))))))

(defun julian-to-datetime (jd)
  "JD -> plist datetime in UTC."
  (multiple-value-bind (y m d h mi s us) (julian-to-discrete-time jd)
    (list :year y :month m :day d :hour h :minute mi :second s :microsecond us)))

(defun fractional-year-to-datetime (fy)
  "Julian year-based fractional year -> datetime plist."
  (let* ((year (truncate fy))
         (rem (- fy year))
         ;; Start of Gregorian year in UTC
         (base (list :year year :month 1 :day 1 :hour 0 :minute 0 :second 0 :microsecond 0))
         (seconds (* rem 365.25 24 60 60))
         (jd0 (discrete-time-to-julian year 1 1 0 0 0 0))
         (jd (+ jd0 (/ seconds 86400.0))))
    (julian-to-datetime jd)))

(defun datetime-to-fractional-year (dt)
  "Datetime plist -> fractional year based on 365.25-day years."
  (let* ((year (getf dt :year))
      (jd (discrete-time-to-julian
        year (getf dt :month) (getf dt :day)
        (getf dt :hour) (getf dt :minute) (getf dt :second)
        (or (getf dt :microsecond) 0)))
         (jd-year-start (discrete-time-to-julian year 1 1 0 0 0 0)))
    (+ year (/ (* 86400.0 (- jd jd-year-start)) (* 365.25 24 60 60)))))

(defun fractional-year-to-julian (fy)
  (if (< fy 1)
      (+ 1721423.5 (* (- fy 1) 365.25))
      (let* ((dt (fractional-year-to-datetime fy)))
        (discrete-time-to-julian (getf dt :year) (getf dt :month) (getf dt :day)
                                 (getf dt :hour) (getf dt :minute) (getf dt :second)
                                 (or (getf dt :microsecond) 0)))))(defun julian-to-fractional-year (jd)
  (let ((jd-yr1 1721423.5))
    (if (< jd jd-yr1)
        (+ 1 (/ (- jd 1721423.5) 365.25))
        (let* ((dt (julian-to-datetime jd)))
          (datetime-to-fractional-year dt)))))

(defun parse-int (s)
  (handler-case (parse-integer s)
    (error () (error "Invalid integer: ~a" s))))

(defun parse-float (s)
  (handler-case (parse-number s)
    (error () (error "Invalid float: ~a" s))))

(defun string-time-to-julian (time-str)
  "Parse string times and return (values jd) or (values jd1 jd2) for intervals.
Returns NIL on invalid Gregorian gap dates (1582-10-05..14)."
  (let* ((s (string-downcase (string-trim '(#\Space #\Tab #\Newline) time-str)))
         (parts (uiop:split-string s :separator " - "))
         (results nil))
    (labels ((push-result (jdt)
               (if (null results)
                   (setf results (list jdt))
                   (setf results (list (first results) jdt))))
             (dt->jd (year &optional (month 1) (day 1))
               (discrete-time-to-julian year month day 0 0 0 0)))
      (dolist (point parts)
        (let* ((pt (string-trim '(#\Space) point))
               (jdt nil))
          (when (alexandria:ends-with-subseq " ad" pt :test #'char=)
            (setf pt (subseq pt 0 (- (length pt) 3))))
          (cond
            ((or (alexandria:ends-with-subseq " ma bp" pt)
                 (alexandria:ends-with-subseq " ma" pt)
                 (alexandria:ends-with-subseq " mya" pt)
                 (alexandria:ends-with-subseq " mya bp" pt))
             (let* ((ma (parse-number (first (uiop:split-string pt :separator " "))))
                    (year (truncate (- 1950 (* ma 1000000.0)))))
               (setf jdt (dt->jd year))))
            ((or (alexandria:ends-with-subseq " ga bp" pt)
                 (alexandria:ends-with-subseq " ga" pt)
                 (alexandria:ends-with-subseq " bya" pt)
                 (alexandria:ends-with-subseq " bya bp" pt))
             (let* ((ga (parse-number (first (uiop:split-string pt :separator " "))))
                    (year (truncate (- 1950 (* ga 1000000000.0)))))
               (setf jdt (dt->jd year))))
            ((or (alexandria:ends-with-subseq " kya bp" pt)
                 (alexandria:ends-with-subseq " ka bp" pt)
                 (alexandria:ends-with-subseq " kyr bp" pt)
                 (alexandria:ends-with-subseq " ka" pt)
                 (alexandria:ends-with-subseq " kyr" pt)
                 (alexandria:ends-with-subseq " kya" pt))
             (let* ((kya (parse-number (first (uiop:split-string pt :separator " "))))
                    (year (truncate (- 1950 (* kya 1000.0)))))
               (setf jdt (dt->jd year))))
            ((alexandria:ends-with-subseq " bp" pt)
             (let* ((bp (parse-integer (first (uiop:split-string pt :separator " "))))
                    (year (- 1950 bp)))
               (setf jdt (dt->jd year))))
            ((alexandria:ends-with-subseq " bc" pt)
             (let* ((core (subseq pt 0 (- (length pt) 3)))
                    (dts (uiop:split-string core :separator "-" :remove-empty-subseqs t))
                    (year 0) (month 1) (day 1))
               (cond
                 ((= (length dts) 1) (setf year (- (parse-int (first dts)) 1)))
                 ((= (length dts) 2) (setf year (- (parse-int (first dts)) 1)
                                           month (parse-int (second dts))))
                 ((= (length dts) 3) (setf year (- (parse-int (first dts)) 1)
                                           month (parse-int (second dts))
                                           day (parse-int (third dts))))
                 (t (error "Invalid date format: ~a" pt)))
               (setf jdt (discrete-time-to-julian year month day 0 0 0 0)))
            (t
             (let* ((dts (uiop:split-string pt :separator "-" :remove-empty-subseqs t))
                    (year 0) (month 1) (day 1))
               (cond
                 ((= (length dts) 1) (setf year (parse-int (first dts))))
                 ((= (length dts) 2) (setf year (parse-int (first dts))
                                           month (parse-int (second dts))))
                 ((= (length dts) 3) (setf year (parse-int (first dts))
                                           month (parse-int (second dts))
                                           day (parse-int (third dts))))
                 (t (error "Invalid date format: ~a" pt)))
               (setf jdt (discrete-time-to-julian year month day 0 0 0 0)))))
          (when (null jdt) (return-from string-time-to-julian nil))
          (push-result jdt)))
      (if (= (length results) 1)
          (values (first results))
          (values (first results) (second results)))))))

(defun julian-to-string-time (jd)
  "JD -> human string, following the Python formatting rules."
  (if (< jd 1721423.5)
      (cond
        ((> jd (- 1721423.5 (* 13000 365.25)))
         (multiple-value-bind (year month day &rest _) (julian-to-discrete-time jd)
           (declare (ignore month day _))
           (format nil "~a BC" (- 1 year))))
        ((> jd (- 1721423.5 (* 100000 365.25)))
         (multiple-value-bind (year &rest _) (julian-to-discrete-time jd)
           (declare (ignore _))
           (format nil "~a BP" (- 1950 year))))
        ((> jd (- 1721423.5 (* 100000000 365.25)))
         (multiple-value-bind (year &rest _) (julian-to-discrete-time jd)
           (declare (ignore _))
           (format nil "~a kya BP" (coerce (/ (- 1950 year) 1000.0) 'single-float))))
        ((> jd (- 1721423.5 (* 10000000000 365.25)))
         (multiple-value-bind (year &rest _) (julian-to-discrete-time jd)
           (declare (ignore _))
           (format nil "~a Ma BP" (coerce (/ (- 1950 year) 1000000.0) 'single-float))))
        (t
         (multiple-value-bind (year &rest _) (julian-to-discrete-time jd)
           (declare (ignore _))
           (format nil "~a Ga BP" (coerce (/ (- 1950 year) 1000000000.0) 'single-float)))))
      (multiple-value-bind (year month day &rest _) (julian-to-discrete-time jd)
        (declare (ignore _))
        (cond
          ((and (= month 1) (= day 1) (< year 1900)) (format nil "~a" year))
          ((and (= day 1) (< year 1900)) (format nil "~a-~2,'0d" year month))
          (t (format nil "~a-~2,'0d-~2,'0d" year month day))))))

(defun julian-to-iso (jd)
  (multiple-value-bind (year month day hour minute second microsecond)
      (julian-to-discrete-time jd)
    (format nil "~a-~2,'0d-~2,'0dT~2,'0d:~2,'0d:~2,'0d.~6,'0dZ"
            year month day hour minute second microsecond)))

(defun iso-to-julian (iso)
  (let* ((parts (uiop:split-string iso :separator "T")) )
    (when (/= (length parts) 2)
      (error "Invalid ISO 8601 string: ~a" iso))
    (let* ((date (first parts))
           (time (second parts)))
      (when (and (> (length time) 0) (char= (char time (1- (length time))) #\Z))
        (setf time (subseq time 0 (1- (length time)))))
      (when (or (search "+" time) (search "-" time))
        (error "Only UTC time is supported: ~a" iso))
      (when (not (digit-char-p (char time (1- (length time)))))
        (error "Invalid ISO 8601 string: ~a" iso))
      (let* ((dparts (if (and (> (length date) 0) (char= (char date 0) #\-))
                         (let ((p (uiop:split-string (subseq date 1) :separator "-")))
                           (setf (first p) (concatenate 'string "-" (first p)))
                           p)
                         (uiop:split-string date :separator "-")))
             (year (parse-int (first dparts)))
             (month (parse-int (second dparts)))
             (day (parse-int (third dparts)))
             (tparts (uiop:split-string time :separator ":"))
             (hour (parse-int (first tparts)))
             (minute (parse-int (second tparts)))
             (sparts (uiop:split-string (third tparts) :separator "."))
             (second (parse-int (first sparts)))
             (microsecond (if (= (length sparts) 1) 0 (parse-int (second sparts)))))
        (discrete-time-to-julian year month day hour minute second microsecond)))))
